# A CMake config file for the library, to be used by external projects

@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(TARGET my-qdmi-device)
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/my-qdmi-device-targets.cmake")

if(NOT my-qdmi-device_FIND_QUIETLY)
  message(STATUS "Found MY QDMI Device version ${my-qdmi-device_VERSION}")
endif()
