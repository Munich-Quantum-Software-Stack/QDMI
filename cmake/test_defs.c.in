/// @file
/// This file is for testing whether a device implements all the required functions.
///
/// It calls all the functions in the device interface to ensure that
/// they are implemented. During linking, when a function is not implemented this
/// will raise an error.
///
/// @note This file is not meant to be ever executed, only linked.

#include "@QDMI_prefix@_qdmi/core.h"

int main(void) {
  @QDMI_PREFIX@_QDMI_initialize(0, NULL, NULL, NULL, NULL);
}
