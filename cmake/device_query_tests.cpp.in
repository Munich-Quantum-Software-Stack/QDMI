namespace {
template <class T>
void CheckSiteProperty(Session session, QDMI_Site_Property property) {
  const auto sites = ReadSites(session);
  if (!sites) {
    if (!::testing::Test::HasFailure()) {
      GTEST_SKIP() << "Sites list is unsupported";
    }
    return;
  }
  size_t supported = 0;
  std::unordered_set<size_t> indices;
  for (size_t i = 0; i < sites->size(); ++i) {
    SCOPED_TRACE(i);
    const auto site = (*sites)[i];
    if (site == nullptr) {
      continue;
    }
    const auto query = SiteQuery(session, site, property);
    const auto value = [&] {
      if constexpr (std::is_same_v<T, bool>) {
        return ReadBool(query);
      } else {
        return Read<T>(query, !std::is_same_v<T, char>,
                       property == QDMI_SITE_PROPERTY_INDEX);
      }
    }();
    if (!value) {
      UnsupportedObject(i);
      continue;
    }
    ++supported;
    if constexpr (std::is_same_v<T, size_t>) {
      if (property == QDMI_SITE_PROPERTY_INDEX) {
        EXPECT_TRUE(indices.insert((*value)[0]).second)
            << "site indices must be unique";
      }
    }
    if (property == QDMI_SITE_PROPERTY_T1 ||
        property == QDMI_SITE_PROPERTY_T2) {
      RequireUnit(session, QDMI_DEVICE_PROPERTY_DURATIONUNIT);
    }
    if (property >= QDMI_SITE_PROPERTY_XCOORDINATE &&
        property <= QDMI_SITE_PROPERTY_ZEXTENT &&
        property != QDMI_SITE_PROPERTY_ISZONE) {
      RequireUnit(session, QDMI_DEVICE_PROPERTY_LENGTHUNIT);
    }
    if (property >= QDMI_SITE_PROPERTY_XEXTENT &&
        property <= QDMI_SITE_PROPERTY_ZEXTENT) {
      const auto zone =
          ReadBool(SiteQuery(session, site, QDMI_SITE_PROPERTY_ISZONE));
      EXPECT_TRUE(zone.value_or(false)) << "nonzone extent must be unsupported";
    }
  }
  if (supported == 0 && !::testing::Test::HasFailure()) {
    GTEST_SKIP() << "No site supports this property";
  }
}

template <class T>
void CheckOperationProperty(Session session, QDMI_Operation_Property property) {
  const auto operations = ReadOperations(session);
  if (!operations) {
    if (!::testing::Test::HasFailure()) {
      GTEST_SKIP() << "Operations list is unsupported";
    }
    return;
  }
  size_t supported = 0;
  for (size_t i = 0; i < operations->size(); ++i) {
    SCOPED_TRACE(i);
    const auto operation = (*operations)[i];
    if (operation == nullptr) {
      continue;
    }
    const auto query = OperationQuery(session, operation, property);
    const auto value = [&] {
      if constexpr (std::is_same_v<T, bool>) {
        return ReadBool(query);
      } else {
        return Read<T>(query,
                       !std::is_same_v<T, char> && !std::is_same_v<T, Site>);
      }
    }();
    if (!value) {
      UnsupportedObject(i);
      continue;
    }
    ++supported;
    if (property == QDMI_OPERATION_PROPERTY_DURATION ||
        property == QDMI_OPERATION_PROPERTY_MEANSHUTTLINGSPEED) {
      RequireUnit(session, QDMI_DEVICE_PROPERTY_DURATIONUNIT);
    }
    if (property == QDMI_OPERATION_PROPERTY_INTERACTIONRADIUS ||
        property == QDMI_OPERATION_PROPERTY_BLOCKINGRADIUS ||
        property == QDMI_OPERATION_PROPERTY_MEANSHUTTLINGSPEED) {
      RequireUnit(session, QDMI_DEVICE_PROPERTY_LENGTHUNIT);
    }
  }
  if (supported == 0 && !::testing::Test::HasFailure()) {
    GTEST_SKIP() << "No operation supports this property";
  }
}
} // namespace

