#include "@QDMI_QUERY_FIXTURE_HEADER@"
#include "@QDMI_QUERY_prefix@_qdmi/device.h"

#include <algorithm>
#include <array>
#include <cstddef>
#include <cstdint>
#include <gtest/gtest.h>
#include <iostream>
#include <limits>
