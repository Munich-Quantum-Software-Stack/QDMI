TEST_F(QDMIQueryFixture, DeviceStatus) {
  const auto value = Read<QDMI_Device_Status>(
      DeviceQuery(session, QDMI_DEVICE_PROPERTY_STATUS), true);
  if (!value && !HasFailure()) {
    GTEST_SKIP() << "Device property is unsupported";
  }
  if (value) {
    EXPECT_GE((*value)[0], QDMI_DEVICE_STATUS_OFFLINE);
    EXPECT_LT((*value)[0], QDMI_DEVICE_STATUS_MAX);
  }
}

