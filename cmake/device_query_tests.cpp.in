TEST_F(QDMIQueryFixture, DeviceInvalidProperty) {
  EXPECT_EQ(DeviceQuery(session, QDMI_DEVICE_PROPERTY_MAX)(0, nullptr, nullptr),
            QDMI_ERROR_INVALIDARGUMENT)
      << "invalid device property";
}

TEST_F(QDMIQueryFixture, RemovedDeviceProperties) {
  for (const auto reserved : {8, 9}) {
    SCOPED_TRACE(reserved);
    const auto query =
        DeviceQuery(session, static_cast<QDMI_Device_Property>(reserved));
    EXPECT_EQ(query(0, nullptr, nullptr), QDMI_ERROR_NOTSUPPORTED);
    size_t size = 0;
    EXPECT_EQ(query(std::numeric_limits<size_t>::max(), nullptr, &size),
              QDMI_ERROR_NOTSUPPORTED);
  }
}

TEST_F(QDMIQueryFixture, DeviceNullSession) {
  for (int i = 0; i < QDMI_DEVICE_PROPERTY_MAX; ++i) {
    if (i == 8 || i == 9) {
      continue;
    }
    const auto property = static_cast<QDMI_Device_Property>(i);
    const auto status = DeviceQuery(session, property)(0, nullptr, nullptr);
    if (status == QDMI_ERROR_NOTSUPPORTED) {
      continue;
    }
    ASSERT_EQ(status, QDMI_SUCCESS);
    EXPECT_EQ(DeviceQuery(nullptr, property)(0, nullptr, nullptr),
              QDMI_ERROR_INVALIDARGUMENT);
    return;
  }
  GTEST_SKIP()
      << "No supported device property for a single-error null-session query";
}

TEST_F(QDMIQueryFixture, SiteInvalidProperty) {
  const auto sites = ReadSites(session);
  if (!sites || sites->empty()) {
    if (!HasFailure()) {
      GTEST_SKIP() << "No advertised site";
    }
    return;
  }
  for (const auto site : *sites) {
    SCOPED_TRACE(site);
    if (site == nullptr) {
      continue;
    }
    EXPECT_EQ(
        SiteQuery(session, site, QDMI_SITE_PROPERTY_MAX)(0, nullptr, nullptr),
        QDMI_ERROR_INVALIDARGUMENT);
  }
}

TEST_F(QDMIQueryFixture, OperationInvalidProperty) {
  const auto operations = ReadOperations(session);
  if (!operations || operations->empty()) {
    if (!HasFailure()) {
      GTEST_SKIP() << "No advertised operation";
    }
    return;
  }
  for (const auto operation : *operations) {
    SCOPED_TRACE(operation);
    if (operation == nullptr) {
      continue;
    }
    EXPECT_EQ(OperationQuery(session, operation,
                             QDMI_OPERATION_PROPERTY_MAX)(0, nullptr, nullptr),
              QDMI_ERROR_INVALIDARGUMENT);
  }
}

TEST_F(QDMIQueryFixture, SiteNullSession) {
  const auto objects = ReadSites(session);
  if (!objects) {
    if (!HasFailure()) {
      GTEST_SKIP() << "No sites list";
    }
    return;
  }
  for (const auto object : *objects) {
    if (object == nullptr) {
      continue;
    }
    for (int i = 0; i < QDMI_SITE_PROPERTY_MAX; ++i) {
      const auto property = static_cast<QDMI_Site_Property>(i);
      const auto status =
          SiteQuery(session, object, property)(0, nullptr, nullptr);
      if (status == QDMI_ERROR_NOTSUPPORTED) {
        continue;
      }
      ASSERT_EQ(status, QDMI_SUCCESS);
      EXPECT_EQ(SiteQuery(nullptr, object, property)(0, nullptr, nullptr),
                QDMI_ERROR_INVALIDARGUMENT);
      return;
    }
  }
  if (!HasFailure()) {
    GTEST_SKIP() << "No supported property on a valid advertised object";
  }
}

TEST_F(QDMIQueryFixture, SiteNullHandle) {
  const auto objects = ReadSites(session);
  if (!objects) {
    if (!HasFailure()) {
      GTEST_SKIP() << "No sites list";
    }
    return;
  }
  for (const auto object : *objects) {
    if (object == nullptr) {
      continue;
    }
    for (int i = 0; i < QDMI_SITE_PROPERTY_MAX; ++i) {
      const auto property = static_cast<QDMI_Site_Property>(i);
      const auto status =
          SiteQuery(session, object, property)(0, nullptr, nullptr);
      if (status == QDMI_ERROR_NOTSUPPORTED) {
        continue;
      }
      ASSERT_EQ(status, QDMI_SUCCESS);
      EXPECT_EQ(SiteQuery(session, nullptr, property)(0, nullptr, nullptr),
                QDMI_ERROR_INVALIDARGUMENT);
      return;
    }
  }
  if (!HasFailure()) {
    GTEST_SKIP() << "No supported property on a valid advertised object";
  }
}

TEST_F(QDMIQueryFixture, OperationNullSession) {
  const auto objects = ReadOperations(session);
  if (!objects) {
    if (!HasFailure()) {
      GTEST_SKIP() << "No operations list";
    }
    return;
  }
  for (const auto object : *objects) {
    if (object == nullptr) {
      continue;
    }
    for (int i = 0; i < QDMI_OPERATION_PROPERTY_MAX; ++i) {
      const auto property = static_cast<QDMI_Operation_Property>(i);
      const auto status =
          OperationQuery(session, object, property)(0, nullptr, nullptr);
      if (status == QDMI_ERROR_NOTSUPPORTED) {
        continue;
      }
      ASSERT_EQ(status, QDMI_SUCCESS);
      EXPECT_EQ(OperationQuery(nullptr, object, property)(0, nullptr, nullptr),
                QDMI_ERROR_INVALIDARGUMENT);
      return;
    }
  }
  if (!HasFailure()) {
    GTEST_SKIP() << "No supported property on a valid advertised object";
  }
}

