namespace {
using Session = @QDMI_QUERY_PREFIX@_QDMI_Device_Session;
using Site = @QDMI_QUERY_PREFIX@_QDMI_Site;
using Operation = @QDMI_QUERY_PREFIX@_QDMI_Operation;

auto DeviceQuery(Session session, QDMI_Device_Property prop) {
  return [=](size_t size, void *value, size_t *size_ret) {
    return @QDMI_QUERY_PREFIX@_QDMI_device_session_query_device_property(
        session, prop, size, value, size_ret);
  };
}
auto SiteQuery(Session session, Site site, QDMI_Site_Property prop) {
  return [=](size_t size, void *value, size_t *size_ret) {
    return @QDMI_QUERY_PREFIX@_QDMI_device_session_query_site_property(
        session, site, prop, size, value, size_ret);
  };
}
auto OperationQuery(Session session, Operation operation,
                    QDMI_Operation_Property prop) {
  return [=](size_t size, void *value, size_t *size_ret) {
    return @QDMI_QUERY_PREFIX@_QDMI_device_session_query_operation_property(
        session, operation, 0, nullptr, 0, nullptr, prop, size, value,
        size_ret);
  };
}

// Optional means unsupported or unusable; GoogleTest retains every error.
template <class T, class Query>
auto Read(Query query, bool scalar = true, bool mandatory = false)
    -> std::optional<std::vector<T>> {
  size_t bytes = 0;
  const auto status = query(0, nullptr, &bytes);
  if (status == QDMI_SUCCESS || status == QDMI_ERROR_NOTSUPPORTED) {
    EXPECT_EQ(query(0, nullptr, nullptr), status);
    EXPECT_EQ(query(std::numeric_limits<size_t>::max(), nullptr, nullptr),
              status);
  }
  if (status == QDMI_ERROR_NOTSUPPORTED) {
    EXPECT_FALSE(mandatory) << "mandatory site index is unsupported";
    return std::nullopt;
  }
  EXPECT_EQ(status, QDMI_SUCCESS);
  if (status != QDMI_SUCCESS) {
    return std::nullopt;
  }
  if (scalar && bytes != sizeof(T)) {
    ADD_FAILURE() << "scalar payload size: " << bytes << ", expected "
                  << sizeof(T);
    return std::nullopt;
  }
  if (bytes % sizeof(T) != 0) {
    ADD_FAILURE() << "array payload size is not divisible by element size";
    return std::nullopt;
  }
  // This is a test-process allocation limit, not a QDMI requirement.
  if (bytes > 64U * 1024U * 1024U) {
    ADD_FAILURE() << "payload exceeds the 64 MiB harness allocation limit";
    return std::nullopt;
  }
  if constexpr (std::is_same_v<T, char>) {
    if (bytes == 0) {
      ADD_FAILURE() << "string payload has no trailing NUL";
      return std::nullopt;
    }
  }
  // One extra aligned element gives empty queries a valid nonnull buffer too.
  std::vector<T> values(bytes / sizeof(T) + 1);
  // Retrieve after error probes; errors need not preserve the buffer.
  if (bytes != 0) {
    EXPECT_EQ(query(bytes - 1, values.data(), nullptr),
              QDMI_ERROR_INVALIDARGUMENT)
        << "one-byte-small buffer";
  }
  for (const auto capacity : {bytes, bytes + sizeof(T)}) {
    for (const bool return_size : {false, true}) {
      size_t actual = bytes;
      const auto result =
          query(capacity, values.data(), return_size ? &actual : nullptr);
      EXPECT_EQ(result, QDMI_SUCCESS) << "payload retrieval failed; metadata "
                                         "may have changed since size probe";
      if (result != QDMI_SUCCESS) {
        return std::nullopt;
      }
      EXPECT_EQ(actual, bytes) << "payload size changed since size probe";
      if (actual != bytes) {
        return std::nullopt;
      }
      if constexpr (std::is_same_v<T, char>) {
        EXPECT_EQ(values[bytes - 1], '\0') << "string payload must end in NUL";
      }
    }
  }
  values.pop_back();
  return values;
}

// vector<bool> has no data(); use one aligned bool object for this scalar.
template <class Query> auto ReadBool(Query query) -> std::optional<bool> {
  size_t bytes = 0;
  const auto status = query(0, nullptr, &bytes);
  if (status == QDMI_SUCCESS || status == QDMI_ERROR_NOTSUPPORTED) {
    EXPECT_EQ(query(0, nullptr, nullptr), status);
    EXPECT_EQ(query(std::numeric_limits<size_t>::max(), nullptr, nullptr),
              status);
  }
  if (status == QDMI_ERROR_NOTSUPPORTED) {
    return std::nullopt;
  }
  EXPECT_EQ(status, QDMI_SUCCESS);
  if (status != QDMI_SUCCESS) {
    return std::nullopt;
  }
  if (bytes != sizeof(bool)) {
    ADD_FAILURE() << "scalar payload size does not match bool";
    return std::nullopt;
  }
  std::array<bool, 2> values{};
  EXPECT_EQ(query(bytes - 1, values.data(), nullptr),
            QDMI_ERROR_INVALIDARGUMENT);
  for (const auto capacity : {sizeof(bool), sizeof(values)}) {
    for (const bool return_size : {false, true}) {
      size_t actual = bytes;
      const auto result =
          query(capacity, values.data(), return_size ? &actual : nullptr);
      EXPECT_EQ(result, QDMI_SUCCESS);
      if (result != QDMI_SUCCESS) {
        return std::nullopt;
      }
      EXPECT_EQ(actual, bytes) << "payload size changed since size probe";
      if (actual != bytes) {
        return std::nullopt;
      }
    }
  }
  return values[0];
}

auto ReadSites(Session session) {
  auto sites =
      Read<Site>(DeviceQuery(session, QDMI_DEVICE_PROPERTY_SITES), false);
  if (sites) {
    for (auto site : *sites) {
      EXPECT_NE(site, nullptr) << "advertised site handle";
    }
  }
  return sites;
}
auto ReadOperations(Session session) {
  auto operations = Read<Operation>(
      DeviceQuery(session, QDMI_DEVICE_PROPERTY_OPERATIONS), false);
  if (operations) {
    for (auto operation : *operations) {
      EXPECT_NE(operation, nullptr) << "advertised operation handle";
    }
  }
  return operations;
}

void RequireUnit(Session session, QDMI_Device_Property property) {
  const auto unit = Read<char>(DeviceQuery(session, property), false);
  ASSERT_TRUE(unit) << "unit is required for supported physical values";
}

void UnsupportedObject(size_t index) {
  std::cout << "Property unsupported for object " << index << '\n';
}
} // namespace

TEST_F(QDMIQueryFixture, DeviceName) {
  const auto value =
      Read<char>(DeviceQuery(session, QDMI_DEVICE_PROPERTY_NAME), false);
  if (!value && !HasFailure()) {
    GTEST_SKIP() << "Device property is unsupported";
  }
}

