TEST_F(QDMIQueryFixture, DeviceSupportedProgramFormats) {
  const auto value = Read<QDMI_Program_Format>(
      DeviceQuery(session, QDMI_DEVICE_PROPERTY_SUPPORTEDPROGRAMFORMATS),
      false);
  if (!value && !HasFailure()) {
    GTEST_SKIP() << "Device property is unsupported";
  }
  if (value) {
    constexpr std::array formats{QDMI_PROGRAM_FORMAT_QASM2,
                                 QDMI_PROGRAM_FORMAT_QASM3,
                                 QDMI_PROGRAM_FORMAT_QIRBASESTRING,
                                 QDMI_PROGRAM_FORMAT_QIRBASEMODULE,
                                 QDMI_PROGRAM_FORMAT_QIRADAPTIVESTRING,
                                 QDMI_PROGRAM_FORMAT_QIRADAPTIVEMODULE,
                                 QDMI_PROGRAM_FORMAT_QPY,
                                 QDMI_PROGRAM_FORMAT_IQMJSON,
                                 QDMI_PROGRAM_FORMAT_CUSTOM1,
                                 QDMI_PROGRAM_FORMAT_CUSTOM2,
                                 QDMI_PROGRAM_FORMAT_CUSTOM3,
                                 QDMI_PROGRAM_FORMAT_CUSTOM4,
                                 QDMI_PROGRAM_FORMAT_CUSTOM5};
    for (const auto format : *value) {
      EXPECT_NE(std::find(formats.begin(), formats.end(), format),
                formats.end())
          << "advertised program format must be a defined format";
    }
  }
}

