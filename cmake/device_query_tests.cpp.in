TEST_F(QDMIQueryFixture, CouplingMapRelationships) {
  const auto edges =
      Read<Site>(DeviceQuery(session, QDMI_DEVICE_PROPERTY_COUPLINGMAP), false);
  if (!edges) {
    if (!HasFailure()) {
      GTEST_SKIP() << "Coupling map is unsupported";
    }
    return;
  }
  EXPECT_EQ(edges->size() % 2, 0U) << "coupling map must contain pairs";
  const auto sites = ReadSites(session);
  if (!sites) {
    if (!HasFailure()) {
      GTEST_SKIP() << "Site membership unavailable; pair shape was checked";
    }
    return;
  }
  const std::unordered_set<Site> members(sites->begin(), sites->end());
  for (const auto site : *edges) {
    EXPECT_TRUE(members.contains(site))
        << "coupling endpoint is not an advertised site";
  }
}

TEST_F(QDMIQueryFixture, SiteCoordinateUniqueness) {
  const auto sites = ReadSites(session);
  if (!sites) {
    if (!HasFailure()) {
      GTEST_SKIP() << "Sites are unsupported";
    }
    return;
  }
  std::unordered_set<std::string> coordinates;
  size_t complete = 0;
  for (size_t i = 0; i < sites->size(); ++i) {
    SCOPED_TRACE(i);
    const auto site = (*sites)[i];
    if (site == nullptr) {
      continue;
    }
    const auto x =
        Read<int64_t>(SiteQuery(session, site, QDMI_SITE_PROPERTY_XCOORDINATE));
    const auto y =
        Read<int64_t>(SiteQuery(session, site, QDMI_SITE_PROPERTY_YCOORDINATE));
    const auto z =
        Read<int64_t>(SiteQuery(session, site, QDMI_SITE_PROPERTY_ZCOORDINATE));
    if (!x || !y || !z) {
      UnsupportedObject(i);
      continue;
    }
    ++complete;
    const auto key = std::to_string((*x)[0]) + "," + std::to_string((*y)[0]) +
                     "," + std::to_string((*z)[0]);
    EXPECT_TRUE(coordinates.insert(key).second)
        << "coordinate triples must be unique";
  }
  if (complete == 0 && !HasFailure()) {
    GTEST_SKIP() << "No complete coordinate triple";
  }
}

TEST_F(QDMIQueryFixture, OperationSiteRelationships) {
  const auto operations = ReadOperations(session);
  if (!operations) {
    if (!HasFailure()) {
      GTEST_SKIP() << "Operations are unsupported";
    }
    return;
  }
  const auto sites = ReadSites(session);
  std::unordered_set<Site> members;
  std::unordered_set<Site> zones;
  if (sites) {
    members.insert(sites->begin(), sites->end());
    for (const auto site : *sites) {
      if (site == nullptr) {
        continue;
      }
      if (ReadBool(SiteQuery(session, site, QDMI_SITE_PROPERTY_ISZONE))
              .value_or(false)) {
        zones.insert(site);
      }
    }
  }
  size_t supported = 0;
  for (size_t i = 0; i < operations->size(); ++i) {
    SCOPED_TRACE(i);
    const auto operation = (*operations)[i];
    if (operation == nullptr) {
      continue;
    }
    const auto applicable = Read<Site>(
        OperationQuery(session, operation, QDMI_OPERATION_PROPERTY_SITES),
        false);
    if (!applicable) {
      UnsupportedObject(i);
      continue;
    }
    ++supported;
    const auto zoned = ReadBool(
        OperationQuery(session, operation, QDMI_OPERATION_PROPERTY_ISZONED));
    if (sites) {
      for (const auto site : *applicable) {
        EXPECT_TRUE(members.contains(site))
            << "operation site is not advertised";
        if (zoned.value_or(false)) {
          EXPECT_TRUE(zones.contains(site))
              << "global operation requires zone sites";
        }
      }
    }
    if (!zoned.value_or(false)) {
      const auto arity = Read<size_t>(OperationQuery(
          session, operation, QDMI_OPERATION_PROPERTY_QUBITSNUM));
      if (arity && (*arity)[0] != 0) {
        EXPECT_EQ(applicable->size() % (*arity)[0], 0U)
            << "local site tuple width must match arity";
      }
    }
  }
  if (supported == 0 && !HasFailure()) {
    GTEST_SKIP() << "Operation sites are unsupported";
  }
}
