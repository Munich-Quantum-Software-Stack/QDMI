#include "@QDMI_QUERY_prefix@_qdmi/device.h"

#include <cstddef>
#include <gtest/gtest.h>

#include "@QDMI_QUERY_FIXTURE_HEADER@"

TEST_F(QDMIQueryFixture, DeviceStatus) {
  size_t size = 0;
  const auto status = @QDMI_QUERY_PREFIX@_QDMI_device_session_query_device_property(
      session, QDMI_DEVICE_PROPERTY_STATUS, 0, nullptr, &size);
  if (status == QDMI_ERROR_NOTSUPPORTED) {
    GTEST_SKIP() << "Device status is not supported";
  }
  ASSERT_EQ(status, QDMI_SUCCESS);
  ASSERT_EQ(size, sizeof(QDMI_Device_Status));
  QDMI_Device_Status value{};
  EXPECT_EQ(@QDMI_QUERY_PREFIX@_QDMI_device_session_query_device_property(
                session, QDMI_DEVICE_PROPERTY_STATUS, sizeof(value), &value,
                nullptr),
            QDMI_SUCCESS);
}
